<nav
  ...attributes
  class="mobile-pane__nav"
  {{this.positionIndicator}}
  {{on "touchstart" this.startScrolling}}
  {{on "touchend" this.stopScrolling}}
>
  <ul class="nav__scroller" role="tablist">
    {{! TODO: make it yieldable if there is a block }}
    {{#each @navItems as |navItem|}}
      <MobilePane::Nav::Item
        @navItem={{navItem}}
        @activePane={{@activePane}}
        @onClick={{@onItemClick}}
        @registerItem={{this.registerItem}}
        @unregisterItem={{this.unregisterItem}}
      />
    {{/each}}
  </ul>
  <span class="nav__indicator"></span>
</nav>