{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:js-lib",
    ":automergeLinters",
    ":automergeTesters",
    ":dependencyDashboard",
    ":maintainLockFilesWeekly",
    ":semanticCommitsDisabled",
    "github>Turbo87/renovate-config:automergeCaretConstraint"
  ],
  "packageRules": [
    {
      "groupName": "ember",
      "matchPackageNames": [
        "ember-source",
        "ember-cli",
        "@ember/**",
        "@glimmer/**",
        "ember-qunit",
        "qunit",
        "qunit-dom"
      ]
    },
    {
      "groupName": "embroider",
      "matchPackageNames": [
        "@embroider/**",
        "vite",
        "rollup",
        "@rollup/**",
        "decorator-transforms"
      ]
    },
    {
      "groupName": "babel",
      "matchPackageNames": [
        "@babel/**",
        "babel-plugin-ember-template-compilation"
      ]
    },
    {
      "groupName": "linting",
      "matchPackageNames": [
        "eslint",
        "eslint-*",
        "@eslint/**",
        "globals",
        "prettier",
        "prettier-*",
        "ember-template-lint",
        "publint"
      ]
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    }
  ]
}
