{
  "name": "ember-mobile-pane",
  "version": "1.0.0",
  "description": "Swipeable, lazily rendered panes with tab navigation for Ember.js mobile apps.",
  "keywords": [
    "ember-addon",
    "mobile",
    "swipe",
    "pane",
    "tabs",
    "gestures"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nickschot/ember-mobile-pane"
  },
  "license": "MIT",
  "author": "Nick Schot <nickschot@webhub.nl>",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./addon-main.js": "./addon-main.cjs",
    "./*.css": "./dist/*.css",
    "./*": {
      "default": "./dist/*.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:publish": "pnpm build && publint run --level error",
    "prepack": "rollup --config",
    "start": "vite dev",
    "test": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.8.9",
    "decorator-transforms": "^2.2.2",
    "ember-gesture-modifiers": "^6.1.0",
    "ember-modifier": "^4.2.2",
    "wobble": "^1.5.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/runtime": "7.29.10",
    "@ember/test-helpers": "5.7.0",
    "@ember/test-waiters": "4.1.2",
    "@embroider/addon-dev": "8.4.2",
    "@embroider/compat": "4.1.27",
    "@embroider/core": "4.6.9",
    "@embroider/macros": "1.21.3",
    "@embroider/vite": "1.7.15",
    "@eslint/js": "9.39.5",
    "@glimmer/component": "2.1.1",
    "@rollup/plugin-babel": "7.1.0",
    "babel-plugin-ember-template-compilation": "4.0.1",
    "concurrently": "9.2.5",
    "ember-qunit": "9.2.0",
    "ember-source": "7.3.0",
    "ember-strict-application-resolver": "0.1.1",
    "ember-template-lint": "7.9.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-ember": "12.7.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.24.0",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "prettier-plugin-ember-template-tag": "2.1.8",
    "publint": "0.3.25",
    "qunit": "3.0.0",
    "qunit-dom": "3.6.0",
    "release-plan": "0.20.1",
    "rollup": "4.64.3",
    "testem": "3.21.3",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "@glimmer/component": "^1.1.2 || ^2.0.0",
    "ember-source": ">= 3.28.0"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">= 20"
  },
  "volta": {
    "node": "22.23.3",
    "pnpm": "10.34.6"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/mobile-pane-infinite.js": "./dist/_app_/components/mobile-pane-infinite.js",
      "./components/mobile-pane-infinite/child.js": "./dist/_app_/components/mobile-pane-infinite/child.js",
      "./components/mobile-pane.js": "./dist/_app_/components/mobile-pane.js",
      "./components/mobile-pane/nav.js": "./dist/_app_/components/mobile-pane/nav.js",
      "./components/mobile-pane/nav/item.js": "./dist/_app_/components/mobile-pane/nav/item.js",
      "./components/mobile-pane/pane.js": "./dist/_app_/components/mobile-pane/pane.js",
      "./components/mobile-pane/scroller.js": "./dist/_app_/components/mobile-pane/scroller.js",
      "./components/mobile-pane/simple-indicator.js": "./dist/_app_/components/mobile-pane/simple-indicator.js"
    }
  }
}
